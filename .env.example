# Runtime/API keys
GEMINI_API_KEY=replace_with_gemini_api_key
PEXELS_API_KEY=replace_with_pexels_api_key

# Frontend build-time vars (Vite)
VITE_API_BASE_URL=https://findmerates.com
VITE_ADSENSE_CLIENT_ID=ca-pub-5800977493749262
VITE_ENABLE_ADS=TRUE
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/replace_monthly_link
VITE_STRIPE_6MONTH_LINK=https://buy.stripe.com/replace_6month_link
VITE_PAYPAL_PAYMENT_LINK=https://www.paypal.com/checkoutnow?token=REPLACE_WITH_TOKEN
VITE_PAYPAL_6MONTH_LINK=https://www.paypal.com/checkoutnow?token=REPLACE_WITH_TOKEN
VITE_CLARITY_PROJECT_ID=replace_with_clarity_project_id

# Firebase (client config)
VITE_FIREBASE_API_KEY=replace_with_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_app_id

# Server protection
CRON_SECRET=replace_with_long_random_secret

# Environment
NODE_ENV=production
DISABLE_HMR=false
